generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Question {
  id        Int      @id @default(autoincrement())
  type      String   @default("regular") // regular | gate | trigger
  dim       String   @default("")        // e.g. "A1", empty for gate/trigger
  text      String
  order     Int      @default(0)
  active    Boolean  @default(true)
  locale    String   @default("zh")
  options   Option[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Option {
  id        Int      @id @default(autoincrement())
  label     String
  score     Int?     // for regular questions
  value     String?  // for gate/trigger questions
  trigger   String?  // e.g. "GLJL"
  order     Int      @default(0)
  question  Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId Int
}

model PersonalityType {
  id        Int      @id @default(autoincrement())
  code      String
  locale    String   @default("zh")
  name      String
  group     String   @default("") // e.g. "gan", "yun"
  emoji     String   @default("")
  color     String   @default("")
  img       String   @default("")
  vector    String   // e.g. "HHH-MMM-MMM-MMM-MMM"
  desc      String   @default("")
  slogan    String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([code, locale])
}

model SpecialType {
  id        Int      @id @default(autoincrement())
  code      String
  locale    String   @default("zh")
  name      String
  emoji     String   @default("")
  color     String   @default("")
  img       String   @default("")
  trigger   String   @default("")
  desc      String   @default("")
  slogan    String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([code, locale])
}

model TestRecord {
  id           Int      @id @default(autoincrement())
  userId       String   // device-based UUID
  resultCode   String
  resultName   String
  similarity   Float
  userVector   String
  isSpecial    Boolean  @default(false)
  answers      String   @default("{}") // JSON: { questionIdx: answer }
  createdAt    DateTime @default(now())
}
